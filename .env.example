# Copy to .env and adjust. Everything here is optional; email and AI can also be set in the UI.

# Port on the host (the app always listens on 3030 inside the container)
HOST_PORT=3030

# Time zone for logs (schedules have their own time zone field)
TZ=Europe/London

# Key used to encrypt tokens and passwords in the database.
# If unset, a random key is generated in the data volume.
APP_SECRET=change-me-to-a-long-random-string

# Protect the UI with HTTP basic auth (recommended when exposed on a network)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Fallback for the Claude API key (the Settings page takes precedence)
ANTHROPIC_API_KEY=

# Host folder with local git repositories, mounted read-only at /repos
LOCAL_REPOS_DIR=./repos
